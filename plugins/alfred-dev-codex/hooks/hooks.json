{
  "description": "Alfred Dev - hooks del ciclo de vida del plugin (port para Codex, sin bash)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session_bootstrap.py\"",
            "timeout": 10,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/session_bootstrap.py\""
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 5,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/session_start.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/session-end.py\"",
            "async": true,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/session-end.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/activity-capture.py\"",
            "timeout": 10,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/activity-capture.py\""
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/prompt-route.py\"",
            "timeout": 5,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/prompt-route.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/secret-guard.py\"",
            "timeout": 5,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/secret-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/dangerous-command-guard.py\"",
            "timeout": 5,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/dangerous-command-guard.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/sensitive-read-guard.py\"",
            "timeout": 5,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/sensitive-read-guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/activity-capture.py\"",
            "timeout": 10,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/activity-capture.py\""
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/quality-gate.py\"",
            "timeout": 10,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/quality-gate.py\""
          },
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/evidence-guard.py\"",
            "timeout": 10,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/evidence-guard.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/activity-capture.py\"",
            "timeout": 10,
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/activity-capture.py\""
          }
        ]
      }
    ]
  }
}
